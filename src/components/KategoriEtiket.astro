---
interface Props {
  kategori: 'gezi' | 'teknik';
  /** true ise filtre sayfasına link olur; listede sessiz düz metin (false) */
  link?: boolean;
}
const { kategori, link = false } = Astro.props;
---
{
  link ? (
    <a class="kat" href={`/kategori/${kategori}`}>{kategori}</a>
  ) : (
    <span class="kat">{kategori}</span>
  )
}
