---
interface Props {
  kategori: 'gezi' | 'teknik';
  /** true ise filtre sayfasına link olur, değilse düz etiket */
  link?: boolean;
}
const { kategori, link = true } = Astro.props;
const etiket = kategori; // "gezi" | "teknik"
---
{
  link ? (
    <a class="etiket" href={`/kategori/${kategori}`}>{etiket}</a>
  ) : (
    <span class="etiket">{etiket}</span>
  )
}
